# Voice Copilot dedicated server — copy this file to `.env` and adjust as needed.
# This server is independent of the Live2D project's app.js and its .env (plan.md §4).

# Network binding (plan.md §4.6) — defaults are intentionally narrow: localhost-only,
# single allowlisted CORS origin. This server holds Provider Credential material, so it
# should not be reachable beyond this machine unless you deliberately override these.
VOICE_COPILOT_SERVER_PORT=4100
VOICE_COPILOT_SERVER_HOST=127.0.0.1
VOICE_COPILOT_ALLOWED_ORIGIN=http://localhost:3000

# Translation Provider (Gemini) credential (spec.md §13.1/§13.2) — the only place this
# credential is configured. It is a server-held deployment secret, not something end
# users fill into a Settings form: set it here (or via your deployment platform's env
# config) and restart the server. Leave unset to run with Translated Speak/Chinese ->
# English disabled — the app falls back cleanly to Direct Speak only.
# GEMINI_API_KEY=
